{
  "name": "vuesp.kc868-a16",
  "version": "5.0.0",
  "author": "bondrogeen",
  "description": "KC868-A16: 16 inputs/outputs, Ethernet, Modbus RTU and Vuesp web UI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bondrogeen/vuesp.kc868-a16"
  },
  "homepage": "https://vuesp.ru",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bondrogeen/vuesp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "vue",
    "vuesp",
    "esp",
    "esp32",
    "esp8266",
    "webinterface",
    "arduino"
  ],
  "scripts": {
    "preview": "vite preview",
    "build-web": "vue-tsc -b && vite build",
    "build": "npm run scripts && npm run build-web && npm run firmware",
    "dev": "vite",
    "firmware": "cd ../ && sh scripts/script.sh build",
    "scripts": "npm run increment && npm run recovery && npm run protocol",
    "increment": "node ./scripts/increment.js",
    "recovery": "node ./scripts/recovery.js /recovery/ ../src/pages",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src/**/*.{vue,js,ts,json,css}",
    "check": "npm run typecheck && npm run lint",
    "screen": "node ./scripts/screen/capture.mjs",
    "screen:install": "playwright install chromium",
    "screen:mock": "node ./scripts/screen/mock-device.mjs",
    "dev:mock": "node ./scripts/screen/dev.mjs",
    "tests": "cd ../src/tests g++ -std=c++11 -DVUESP_LOG_LEVEL=3 -I.. -I. -g -o test_runner test_runner.cpp arduino_stub.cpp ../runner/ScriptRunner.cpp && ./test_runner",
    "lint:fix": "eslint . --fix",
    "build:demo": "npm run protocol && vite build --mode demo",
    "sync:demo": "rm -rf ../../vuesp.ru/public/demo-app && cp -r ../demo-dist ../../vuesp.ru/public/demo-app",
    "demo": "npm run build:demo && npm run sync:demo",
    "protocol": "node ./scripts/protocol-and-json.js",
    "protocol:check": "node ./scripts/protocol-and-json.js --check"
  },
  "dependencies": {
    "@vueuse/core": "13.9.0",
    "pinia": "3.0.3",
    "tailwindcss": "4.1.13",
    "vue": "3.5.45",
    "vue-router": "4.5.1",
    "vuesp-components": "file:../../../vuesp-components",
    "vuesp-struct": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/websocket": "1.0.10",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^9.27.0",
    "minify": "9.1.0",
    "node-gzip": "^1.1.2",
    "playwright": "^1.65.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.12.0",
    "vite": "^6.4.3",
    "vite-plugin-compression2": "^1.3.3",
    "vue-tsc": "^3.3.14",
    "ws": "^8.22.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
